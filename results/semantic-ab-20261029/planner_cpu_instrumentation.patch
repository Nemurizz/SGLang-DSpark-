+    def set_dynamic_max_verify_len(self, max_len: Optional[int]) -> None:
+        """Set a per-request upper bound for adaptive DSpark verification.
+
+        The captured graphs remain sized for the configured gamma. This only
+        changes the confidence scheduler's row cap, so shortening the active
+        verify window is exact and does not require graph recapture.
+        """
+        if max_len is None:
+            self._schedule_cfg.max_verify_len = 0
+            return
+        value = max(1, min(int(max_len), self.gamma + 1))
+        self._schedule_cfg.max_verify_len = value
