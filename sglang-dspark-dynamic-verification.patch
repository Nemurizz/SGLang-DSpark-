+def should_use_compact_verify(
+    *,
+    graph_num_tokens: int,
+    full_num_tokens: int,
+    min_token_savings_ratio: float,
+) -> bool:
+    if min_token_savings_ratio <= 0.0:
+        return True
+    if full_num_tokens <= 0:
+        return False
+
+    token_savings_ratio = max(
+        0.0,
+        1.0 - float(graph_num_tokens) / float(full_num_tokens),
+    )
+    return token_savings_ratio >= min_token_savings_ratio
+
